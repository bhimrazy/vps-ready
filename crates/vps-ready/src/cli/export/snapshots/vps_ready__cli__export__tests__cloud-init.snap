---
source: crates/vps-ready/src/cli/export/tests.rs
expression: redact(&text)
---
#cloud-config
# vps-ready <version> (export cloud-init): hardens this server at first boot.
write_files:
  - path: /etc/vps-ready/profile.toml
    permissions: "0600"
    content: |
      schema = 1
      extends = "web"

      [modules."user.admin"]
      name = "ops"
      authorized_keys = ["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGroot me@laptop"]
runcmd:
  - - sh
    - -c
    - |
      set -eu
      case "$(uname -m)" in
        x86_64) t=x86_64-unknown-linux-musl; sum=b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2 ;;
        aarch64) t=aarch64-unknown-linux-musl; sum=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1 ;;
        *) echo "vps-ready: unsupported architecture" >&2; exit 1 ;;
      esac
      f=/root/vps-ready-<version>-$t.tar.gz
      curl -fsSL --retry 5 --retry-connrefused -o "$f" \
        "https://github.com/bhimrazy/vps-ready/releases/download/v<version>/vps-ready-<version>-$t.tar.gz"
      echo "$sum  $f" | sha256sum -c -
      tar -xzf "$f" -C /root
      install -m 0755 "/root/vps-ready-<version>-$t/vps-ready" /usr/local/bin/vps-ready
      vps-ready apply --profile /etc/vps-ready/profile.toml --yes --deadman=off
