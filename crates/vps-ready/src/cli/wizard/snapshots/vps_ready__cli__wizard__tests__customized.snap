user.admin: Set up an admin account that logs in with an SSH key and uses sudo
  note: no `authorized_keys` given: copies 1 key from /root/.ssh/authorized_keys
  + create user admin                                                     partial
  + ~admin/.ssh/authorized_keys (mode 0600, admin:admin)                  reversible
      @@ -0,0 +1 @@
      +ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGroot root@laptop
  + /etc/sudoers.d/90-vps-ready-admin (mode 0440, root:root)              reversible
      @@ -0,0 +1,3 @@
      +# Written by vps-ready (user.admin). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +admin ALL=(ALL:ALL) NOPASSWD: ALL
ssh.server: Turn off root and password logins over SSH (fixes SSH-001, SSH-002, SSH-005)
  note: SSH sessions that are open now stay open; the new settings apply to new logins
  note: Port, ListenAddress, AllowGroups, AuthenticationMethods and the crypto settings stay as they are
  + /etc/ssh/sshd_config.d/00-vps-ready.conf (mode 0644, root:root)       reversible
      @@ -0,0 +1,7 @@
      +# Written by vps-ready (ssh.server). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +# sshd uses the first value it reads for each keyword, and reads this file
      +# before 50-cloud-init.conf and the rest of sshd_config.
      +PermitRootLogin no
      +PasswordAuthentication no
      +X11Forwarding no
firewall.inbound: Drop incoming traffic that no rule allows (fixes FW-001)
  note: always accepts TCP 22, the current SSH ports (this session's, sshd's listeners and `Port`), whatever `allow` says
  + directory /etc/vps-ready (mode 0755, root:root)                       reversible
  + /etc/vps-ready/firewall.nft (mode 0644, root:root)                    reversible
      @@ -0,0 +1,23 @@
      +# Written by vps-ready (firewall.inbound). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +# vps-ready-firewall.service loads it. It replaces only the table
      +# inet vps_ready: other tables, such as Docker's or fail2ban's, stay.
      +table inet vps_ready {}
      +delete table inet vps_ready
      +table inet vps_ready {
      +  chain input {
      +    type filter hook input priority filter; policy drop;
      +    ct state established,related accept
      +    ct state invalid drop
      +    iif lo accept
      +    meta l4proto icmp accept
      +    # Neighbor discovery and path MTU: never block ICMPv6.
      +    meta l4proto icmpv6 accept
      +    # DHCPv4 replies that conntrack does not match (broadcast).
      +    udp sport 67 udp dport 68 accept
      +    # DHCPv6 client.
      +    ip6 saddr fe80::/10 udp dport 546 accept
      +    # The profile's `allow`, plus every current SSH port.
      +    tcp dport { 22 } accept
      +  }
      +}
  + /etc/systemd/system/vps-ready-firewall.service (mode 0644, root:root)  reversible
      @@ -0,0 +1,19 @@
      +# Written by vps-ready (firewall.inbound). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +[Unit]
      +Description=vps-ready: inbound firewall (nftables table inet vps_ready)
      +DefaultDependencies=no
      +Wants=network-pre.target
      +After=nftables.service
      +Before=network-pre.target shutdown.target
      +Conflicts=shutdown.target
      +
      +[Service]
      +Type=oneshot
      +RemainAfterExit=yes
      +ExecStart=/usr/sbin/nft -f /etc/vps-ready/firewall.nft
      +ExecReload=/usr/sbin/nft -f /etc/vps-ready/firewall.nft
      +ExecStop=-/usr/sbin/nft delete table inet vps_ready
      +
      +[Install]
      +WantedBy=sysinit.target
  ~ enable and start vps-ready-firewall.service                           reversible
ssh.bruteforce: Ban addresses that keep failing to log in over SSH
  note: no SSH session found, so only localhost is exempt from bans
  note: if this installs fail2ban, rollback leaves it installed and enabled, as the package sets it up, so it runs the distro's own jails after a reboot; `systemctl disable --now fail2ban` turns it off
  + /etc/fail2ban/jail.d/90-vps-ready.local (mode 0644, root:root)        reversible
      @@ -0,0 +1,9 @@
      +# Written by vps-ready (ssh.bruteforce). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +[DEFAULT]
      +banaction = nftables
      +backend = systemd
      +
      +[sshd]
      +enabled = true
      +ignoreip = 127.0.0.1/8 ::1
  ~ enable and start fail2ban.service                                     reversible
