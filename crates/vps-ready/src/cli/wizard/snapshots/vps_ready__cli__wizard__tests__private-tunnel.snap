      +Type=oneshot
      +TimeoutStartSec=10min
      +ExecStart=/bin/sh /etc/vps-ready/cloudflared-restart.sh
  + /etc/systemd/system/vps-ready-cloudflared-restart.path (mode 0644, root:root)  reversible
      @@ -0,0 +1,11 @@
