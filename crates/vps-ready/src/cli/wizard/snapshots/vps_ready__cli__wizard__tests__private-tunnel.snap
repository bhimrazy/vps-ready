deploy.proxy: Serve sites over HTTPS with Caddy, proxied to their upstreams
  note: caddy is installed without Caddy's repository; this adds it, so apt updates Caddy from there, and the next `apt upgrade` replaces a distro's Caddy with Caddy's own build
  note: rollback removes the Caddyfile, and stops and disables Caddy; the package stays
  + directory /etc/apt/keyrings (mode 0755, root:root)                    reversible
  + /etc/apt/keyrings/caddy.asc (mode 0644, root:root): PGP public key, fingerprint 6576 0C51 EDEA 2017 CEA2 CA15 155B 6D79 CA56 EA34 (109 lines)  reversible
  + /etc/apt/sources.list.d/caddy.sources (mode 0644, root:root)          reversible
      @@ -0,0 +1,7 @@
      +# Written by vps-ready. `vps-ready rollback --last` removes it.
      +Types: deb
      +URIs: https://dl.cloudsmith.io/public/caddy/stable/deb/debian
      +Suites: any-version
      +Components: main
      +Architectures: amd64
      +Signed-By: /etc/apt/keyrings/caddy.asc
  + directory /etc/caddy (mode 0755, root:root)                           reversible
  + /etc/caddy/Caddyfile (mode 0644, root:root)                           reversible
      @@ -0,0 +1,19 @@
      +# Written by vps-ready (deploy.proxy). `vps-ready rollback --last`
      +# restores the previous state; edits here are replaced by the next apply.
      +
      +{
      +	default_bind 127.0.0.1
      +	servers {
      +		trusted_proxies static 127.0.0.1/32
      +		client_ip_headers Cf-Connecting-Ip
      +	}
      +}
      +
      +http://app.example.com {
      +	@plain header X-Forwarded-Proto http
      +	redir @plain https://{host}{uri} 308
      +	reverse_proxy 127.0.0.1:8080 {
      +		header_up X-Forwarded-For {client_ip}
      +		header_up X-Forwarded-Host {host}
      +	}
      +}

