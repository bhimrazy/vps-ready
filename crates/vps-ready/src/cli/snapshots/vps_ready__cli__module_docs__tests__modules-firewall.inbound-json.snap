source: crates/vps-ready/src/cli/module_docs.rs
expression: out
---
{
  "id": "firewall.inbound",
  "title": "Drop incoming traffic that no rule allows",
  "applies": true,
  "arms_safety_timer": true,
  "why": "Without a firewall, any service listening on all addresses, such as a database left at its defaults, is reachable from the internet. This one accepts SSH, the ports the profile allows and replies to the server's own connections, and drops the rest.",
  "params": [
    {
      "name": "allow",
      "default": "[]",
      "help": "Ports to accept from anywhere, e.g. [\"443/tcp\", \"443/udp\"]; the SSH ports are always accepted, only on `ssh_via` when it is set."
    },
    {
      "name": "ssh_via",
      "default": "\"\"",
      "help": "Accept SSH only on this interface, e.g. \"tailscale0\" or \"wg0\", from a session through it; \"vpn\" for the profile's VPN module's interface, which keeps SSH public until applied from a session through it (the private profile), so an interface named vpn cannot be used; empty for any."
    }
  ],
  "controls": [
    {
      "id": "FW-001",
      "severity": "medium",
      "title": "Incoming traffic denied by default"
    }
  ]
}
