---
source: crates/vps-ready/src/cli/module_docs.rs
expression: out
---
{
  "id": "deploy.proxy",
  "title": "Serve sites over HTTPS with Caddy, proxied to their upstreams",
  "applies": true,
  "arms_safety_timer": false,
  "why": "An app published on 127.0.0.1 is safe from the internet but also out of its reach. Caddy in front of it serves it over HTTPS, gets and renews the certificates by itself, and redirects HTTP to HTTPS. Behind a tunnel it serves plain HTTP on loopback instead, and the tunnel's edge does the TLS.",
  "params": [
    {
      "name": "sites",
      "default": "[]",
      "help": "Required: the sites Caddy serves, e.g. [{ domain = \"app.example.com\", upstream = \"127.0.0.1:8080\" }]. Each domain needs a DNS record for this host and ports 80 and 443 open, unless behind_tunnel is set."
    },
    {
      "name": "behind_tunnel",
      "default": "false",
      "help": "Serve every site as plain HTTP on loopback only, for a Cloudflare Tunnel connector (net.tunnel) to forward to: TLS ends at Cloudflare, Caddy gets no certificate, and no public port is needed. The visitor's address comes from Cf-Connecting-Ip."
    }
  ],
  "controls": []
}
