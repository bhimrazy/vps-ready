---
source: crates/vps-ready/src/facts/network.rs
expression: "(&ifs, &routes)"
---
- - name: lo
    kind: ~
    addresses:
      - ip: 127.0.0.1
        prefix: 8
      - ip: "::1"
        prefix: 128
  - name: eth0
    kind: ~
    addresses:
      - ip: 192.0.2.10
        prefix: 24
      - ip: "2001:db8::10"
        prefix: 64
      - ip: "fe80::5054:ff:fe12:3456"
        prefix: 64
  - name: wg0
    kind: wireguard
    addresses:
      - ip: 10.77.1.1
        prefix: 24
  - name: tailscale0
    kind: tun
    addresses:
      - ip: 100.64.0.7
        prefix: 32
      - ip: "fd7a:115c:a1e0::7"
        prefix: 128
- - dst: default
    dev: eth0
    gateway: 192.0.2.1
    table: ~
  - dst: 192.0.2.0/24
    dev: eth0
    gateway: ~
    table: ~
  - dst: 10.77.1.0/24
    dev: wg0
    gateway: ~
    table: ~
  - dst: 100.64.0.0/10
    dev: tailscale0
    gateway: ~
    table: "52"
  - dst: 192.0.2.10
    dev: eth0
    gateway: ~
    table: local
  - dst: 192.0.2.255
    dev: eth0
    gateway: ~
    table: local
