---
source: crates/vps-ready/src/modules/deploy_user/tests.rs
expression: "plan(&fs, &runner, &facts, &params)"
---
modules:
  - id: deploy.user
    title: Set up a deploy account whose SSH keys are restricted
    status: applicable
    changes:
      - id: "user:deploy"
        summary: create user deploy (groups docker)
        diff: ~
        reversibility: partial
      - id: "authorized-keys:deploy"
        summary: "create ~deploy/.ssh/authorized_keys (0600 deploy:deploy)"
        diff: "@@ -0,0 +1 @@\n+restrict,command=\"/usr/local/bin/deploy-app\" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGdeploy ci@example.com\n"
        reversibility: reversible
      - id: "file:/etc/sudoers.d/90-vps-ready-deploy"
        summary: "create /etc/sudoers.d/90-vps-ready-deploy (0440 0:0)"
        diff: "@@ -0,0 +1,3 @@\n+# Written by vps-ready (deploy.user). `vps-ready rollback --last`\n+# restores the previous state; edits here are replaced by the next apply.\n+deploy ALL=(root) NOPASSWD: /usr/local/bin/deploy-app \"\"\n"
        reversibility: reversible
    notes:
      - "docker = true: deploy joins the docker group, which is root access: it can start a container that mounts / and change anything on this host"
