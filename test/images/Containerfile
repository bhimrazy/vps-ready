# Test image: a distro with systemd as PID 1 and OpenSSH, close to a fresh
# cloud VPS. Debian-family bases only for now (apt). nftables is installed by
# default on Debian and on Ubuntu's cloud images. netbase (`/etc/services`) is
# in every cloud image; nft before 1.1 needs it to resolve fail2ban's `port = ssh`.
#
#   docker build -f test/images/Containerfile --build-arg BASE=debian:13 -t vps-ready-test:debian-13 test/images
#   docker run -d --privileged --cgroupns=private --tmpfs /run --tmpfs /run/lock vps-ready-test:debian-13
ARG BASE=debian:13
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
# CI only: retry flaky mirrors, both here and in vps-ready's own apt calls.
# UPD-001 reads apt's Periodic settings, which this file does not touch.
RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "30";' 'Acquire::https::Timeout "30";' \
      >/etc/apt/apt.conf.d/80ci
# Ubuntu's cloud images run sudo-rs as `sudo` from 25.10 on (the original
# stays as sudo.ws); its Docker image has no sudo at all.
RUN . /etc/os-release \
 && sudo_rs= \
 && if [ "$ID" = ubuntu ] && dpkg --compare-versions "$VERSION_ID" ge 25.10; then sudo_rs=sudo-rs; fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server openssh-client iproute2 nftables netbase sudo $sudo_rs ca-certificates \
 && { [ -z "$sudo_rs" ] || sudo -V | grep -q '^sudo-rs '; } \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/machine-id && touch /etc/machine-id

# Docker's base images disable periodic apt runs; cloud images do not, and that
# file would override the updates.auto drop-in.
RUN rm -f /etc/apt/apt.conf.d/docker-*

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
