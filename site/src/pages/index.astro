---
import Compare from '../components/landing/Compare.astro';
import Faq from '../components/landing/Faq.astro';
import Flow from '../components/landing/Flow.astro';
import Footer from '../components/landing/Footer.astro';
import GetStarted from '../components/landing/GetStarted.astro';
import Hero from '../components/landing/Hero.astro';
import Modules from '../components/landing/Modules.astro';
import Nav from '../components/landing/Nav.astro';
import Roadmap from '../components/landing/Roadmap.astro';
import Safety from '../components/landing/Safety.astro';
import Tested from '../components/landing/Tested.astro';
import Why from '../components/landing/Why.astro';
import Landing from '../layouts/Landing.astro';
import { AUTHOR, DESCRIPTION, LINKS, REPO, VERSION } from '../lib/site';

const url = 'https://vps-ready.bhimraj.com.np/';
const author = { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.site, sameAs: [AUTHOR.github] };
// Facts only: no ratings or reviews.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'vps-ready',
      description: DESCRIPTION,
      url,
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Debian 12, Debian 13, Ubuntu 22.04, Ubuntu 24.04',
      softwareVersion: VERSION,
      downloadUrl: `${REPO}/releases/tag/v${VERSION}`,
      installUrl: `${url}docs/install/`,
      license: ['https://opensource.org/licenses/MIT', 'https://opensource.org/licenses/Apache-2.0'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author,
      sameAs: [REPO, LINKS.crates],
    },
    { '@type': 'WebSite', name: 'vps-ready', url, description: DESCRIPTION, author },
  ],
};
---

<Landing title="vps-ready: secure a fresh Debian or Ubuntu VPS without lockouts" description={DESCRIPTION} jsonLd={jsonLd}>
  <Nav />
  <main id="main">
    <Hero />
    <Why />
    <Flow />
    <Safety />
    <Compare />
    <Modules />
    <Tested />
    <Roadmap />
    <Faq />
    <GetStarted />
  </main>
  <Footer />
</Landing>
