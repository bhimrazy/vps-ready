---
// Shell commands for the docs that wrap only at spaces and after "/" in
// URLs (never mid-word), with a Copy button that copies the exact lines.
// Used where Expressive Code would break a long URL mid-word.
import { breakableCommand } from '../../lib/wrap';

interface Props {
  lines: string[];
}
const { lines } = Astro.props;
---

<figure
  class="not-content relative m-0 rounded-[10px] border border-(--sl-color-gray-5) bg-(--sl-color-gray-7,var(--sl-color-gray-6))"
  data-command
>
  <pre
    class="m-0 grid gap-0.5 border-0 bg-transparent py-3.5 pr-20 pl-4 font-mono text-[0.8125rem] leading-[1.7] text-(--sl-color-white)">{lines.map((l) => (
      <span class="flex items-start gap-[1ch]"><span class="flex-none text-(--sl-color-gray-3) select-none" aria-hidden="true">$</span><span class="min-w-0 break-normal whitespace-pre-wrap" data-cmd set:html={breakableCommand(l)} /></span>
    ))}</pre>
  <button
    type="button"
    data-copy
    aria-label="Copy commands"
    class="absolute top-2 right-2 cursor-pointer rounded-md border border-(--sl-color-gray-5) bg-(--sl-color-black) px-2.5 py-1 font-mono text-xs font-medium text-(--sl-color-gray-2) hover:text-(--sl-color-text-accent)"
  >Copy</button>
</figure>

<script>
  import { copyText } from '../../scripts/copy';

  for (const fig of document.querySelectorAll<HTMLElement>('[data-command]')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-copy]')!;
    btn.addEventListener('click', () => {
      const text = [...fig.querySelectorAll('[data-cmd]')].map((c) => c.textContent).join('\n');
      copyText(text, btn, fig.querySelector('pre')!);
    });
  }
</script>
