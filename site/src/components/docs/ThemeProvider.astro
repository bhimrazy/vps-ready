---
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

{/* Light is the default: on a first visit (no stored choice) store "light" before
  Starlight reads it. Picking Auto or Dark later is stored and respected. */}
<script is:inline>
  try {
    if (localStorage.getItem('starlight-theme') === null) localStorage.setItem('starlight-theme', 'light');
  } catch {}
</script>
<Default />
