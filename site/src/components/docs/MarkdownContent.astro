---
// Weights search results: the user guides and reference above the other pages.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const { id } = Astro.locals.starlightRoute;
const weight = id.startsWith('docs/guides/') || id.startsWith('docs/reference/') ? '2' : undefined;
---

<div data-pagefind-weight={weight}><Default><slot /></Default></div>
