---
// The five commands of a run, left to right; wraps to a column on a phone.
const steps = [
  { cmd: 'audit', tag: 'read-only', text: 'Checks 29 controls and says why each one matters.' },
  { cmd: 'plan', tag: 'read-only', text: 'A diff of every file and setting that would change.' },
  { cmd: 'apply', tag: 'changes', text: 'Snapshot, validate, write, verify. A failure restores everything.' },
  { cmd: 'confirm', tag: 'safety net', text: 'From a new SSH login. Without it, the safety timer rolls back.' },
  { cmd: 'rollback', tag: 'any time', text: 'Undoes a transaction from the journal.' },
];
---

<figure class="not-content run-flow" aria-label="The five commands of a run">
  <ol>
    {
      steps.map((s, i) => (
        <li data-kind={s.tag.replace(' ', '-')}>
          <span class="n">{i + 1}</span>
          <code>{s.cmd}</code>
          <span class="tag">{s.tag}</span>
          <p>{s.text}</p>
        </li>
      ))
    }
  </ol>
  <figcaption>
    <code>confirm</code> is only asked for when the run changes the admin user, the SSH server config or the
    firewall.
  </figcaption>
</figure>

<style>
  .run-flow {
    margin: 1.75rem 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
    counter-reset: none;
  }
  li {
    position: relative;
    margin: 0;
    padding: 0.75rem 0.75rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-black);
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }
  /* The arrow between cards. */
  li + li::before {
    content: '';
    position: absolute;
    left: -1.0625rem;
    top: 1.25rem;
    width: 0.875rem;
    height: 1px;
    background: var(--sl-color-gray-4);
  }
  li + li::after {
    content: '';
    position: absolute;
    left: -0.375rem;
    top: calc(1.25rem - 3px);
    border: 3.5px solid transparent;
    border-left: 5px solid var(--sl-color-gray-4);
  }
  li[data-kind='safety-net'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  .n {
    font: 600 0.6875rem/1 var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  /* Beats the inline-code chip of the docs styles. */
  .run-flow li code {
    font: 700 0.9375rem/1.2 var(--sl-font-mono);
    color: var(--sl-color-white);
    background: none;
    border: 0;
    padding: 0;
  }
  .tag {
    justify-self: start;
    font: 500 0.6875rem/1 var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.1875rem 0.4375rem;
  }
  li[data-kind='safety-net'] .tag,
  li[data-kind='changes'] .tag {
    color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent);
  }
  p {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .run-flow figcaption code {
    font: 500 0.75rem var(--sl-font-mono);
    color: inherit;
  }
  @media (max-width: 52rem) {
    ol {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    li {
      grid-template-columns: 1.25rem auto 1fr;
      align-items: center;
      column-gap: 0.625rem;
    }
    li p {
      grid-column: 2 / -1;
    }
    .tag {
      justify-self: end;
    }
    li + li::before {
      left: 1.25rem;
      top: -0.75rem;
      width: 1px;
      height: 0.625rem;
    }
    li + li::after {
      left: calc(1.25rem - 3px);
      top: -0.3125rem;
      border: 3.5px solid transparent;
      border-top: 5px solid var(--sl-color-gray-4);
    }
  }
</style>
