---
// Starlight's SiteTitle with the brand wordmark (green hyphen) and a "docs" tag.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="vps-ready home">
  {
    config.logo && logos.dark && (
      <>
        <img class="light:sl-hidden print:hidden" alt="" src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
        <img class="dark:sl-hidden print:block" alt="" src={logos.light?.src} width={logos.light?.width} height={logos.light?.height} />
      </>
    )
  }
  <span class="wordmark" translate="no">vps<b>-</b>ready</span>
</a>
<a href={`${import.meta.env.BASE_URL}docs/`} class="docs-tag">docs</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    color: var(--sl-color-white);
  }
  img {
    height: 1.75rem;
    width: auto;
  }
  .wordmark {
    font: 700 1.125rem/1 var(--sl-font-mono);
    letter-spacing: -0.03em;
  }
  .wordmark b {
    color: var(--sl-color-accent);
  }
  .docs-tag {
    margin-inline-start: 0.625rem;
    align-self: center;
    font: 500 0.6875rem/1 var(--sl-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
  }
  .docs-tag:hover {
    color: var(--sl-color-white);
  }
</style>
