---
// Eyebrow, h2 and lede: the head of every section. The title slot allows
// markup (e.g. a no-wrap "vps-ready").
import Label from './Label.astro';

interface Props {
  /** Eyebrow; omitted on sections whose title says enough. */
  label?: string;
  center?: boolean;
  /** No bottom margin, when the parent spaces its children. */
  flush?: boolean;
  class?: string;
}
const { label, center, flush, class: cls } = Astro.props;
---

<div class:list={['grid gap-4', center && 'justify-items-center text-center', !flush && 'mb-11', cls]}>
  {label && <Label>{label}</Label>}
  <h2 class="font-mono text-[clamp(26px,3.2vw,36px)] leading-[1.15] font-bold tracking-[-0.03em] text-balance"><slot name="title" /></h2>
  <p class:list={['max-w-[60ch] text-lg text-muted', center && 'mx-auto']}><slot /></p>
</div>
