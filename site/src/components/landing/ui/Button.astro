---
interface Props {
  href: string;
  primary?: boolean;
  class?: string;
}
const { href, primary, class: cls } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-10 items-center gap-2 rounded-md border px-4 py-2.5 font-mono text-sm font-medium no-underline motion-safe:transition-colors',
    primary
      ? 'border-brand bg-brand text-on-accent motion-safe:hover:bg-brand-ink'
      : 'border-line bg-bg text-ink motion-safe:hover:bg-surface',
    cls,
  ]}><slot /></a
>
