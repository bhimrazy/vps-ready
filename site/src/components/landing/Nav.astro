---
import { REPO } from '../../lib/site';
import Logo from './Logo.astro';

const button =
  'inline-flex min-h-10 items-center rounded-md border border-line bg-bg px-4 py-2.5 font-mono text-sm font-medium text-ink no-underline motion-safe:transition-colors motion-safe:hover:bg-surface';
const links = [
  ['#why', 'Why'],
  ['#flow', 'How it works'],
  ['#safety', 'Safety net'],
  ['#modules', 'Under the hood'],
  ['#faq', 'FAQ'],
  ['/docs/', 'Docs'],
];
---

<nav class="sticky top-0 z-[5] border-b border-line bg-bg">
  <div class="mx-auto w-full max-w-[1160px] px-4 flex h-[60px] items-center justify-between gap-4">
    <a class="flex items-center gap-2.5 font-mono text-lg font-bold no-underline" href="#top" aria-label="vps-ready home">
      <Logo /><span>vps<b class="text-brand">-</b>ready</span>
    </a>
    <ul class="m-0 hidden list-none gap-6 p-0 text-sm min-[801px]:flex">
      {
        links.map(([href, text]) => (
          <li>
            <a class="text-muted no-underline hover:text-ink" href={href}>
              {text}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <a href="/docs/" class:list={[button, 'min-[801px]:hidden']}>Docs</a>
      <a href={REPO} class={button}>GitHub</a>
    </div>
  </div>
</nav>
