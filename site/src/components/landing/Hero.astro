---
import { INSTALL_URL, VERSION } from '../../lib/site';
import { frameHtml, SCREEN } from '../../scripts/motion';
import { heroScenes } from '../../scripts/scenes';
import Label from './ui/Label.astro';
import Pill from './ui/Pill.astro';
import Tab from './ui/Tab.astro';
import Terminal from './ui/Terminal.astro';
import Wrap from './ui/Wrap.astro';

const scenes = Object.keys(heroScenes);
const quick = `curl -fsSL ${INSTALL_URL} | sudo sh`;
---

<header
  id="top"
  class="border-b border-line bg-bg bg-[linear-gradient(var(--color-grid)_1px,transparent_1px),linear-gradient(90deg,var(--color-grid)_1px,transparent_1px)] bg-size-[32px_32px] bg-position-[-1px_-1px] pt-[72px] pb-20"
>
  <Wrap class="grid grid-cols-[minmax(0,1fr)_minmax(0,580px)] items-center gap-12 max-[920px]:grid-cols-[minmax(0,1fr)]">
    <div class="grid min-w-0 justify-items-start gap-5">
      <Label>Linux VPS hardening &middot; v{VERSION}</Label>
      <h1
        class="max-w-[15ch] font-mono text-[clamp(34px,3.4vw,44px)] leading-[1.15] font-bold tracking-[-0.03em] text-balance max-[920px]:max-w-none"
      >
        Harden a fresh server <em class="block text-brand not-italic">without locking yourself out.</em>
      </h1>
      <p class="max-w-[44ch] text-lg text-muted">
        SSH keys, a firewall and automatic updates in one run. If an SSH or firewall change locks you out, it rolls back on its own.
      </p>
      <div class="flex w-full max-w-full items-center overflow-hidden rounded-[10px] border border-line bg-bg">
        <code
          id="quick-cmd"
          class="min-w-0 flex-1 overflow-x-auto px-4 py-3 text-left font-mono text-[12.5px] whitespace-nowrap [mask-image:linear-gradient(to_right,#000_calc(100%-28px),transparent)]"
          ><span class="text-subtle select-none">$ </span><span data-cmd>{quick}</span></code
        >
        <button
          type="button"
          id="quick-copy"
          class="min-h-11 flex-none cursor-pointer self-stretch border-0 border-l border-solid border-line bg-surface px-4 font-mono text-xs font-medium text-ink hover:text-brand"
        >
          Copy
        </button>
      </div>
      <a class="font-mono text-[13px] font-medium text-brand no-underline hover:underline" href="#start">Read the install script first</a>
    </div>

    <Terminal id="demo" title="root@vps: ~" titleId="demo-title" dots class="shadow-term">
      <Pill slot="status" id="demo-clock" tone="a" hidden />
      {
        scenes.map((s, i) => (
          <Tab slot="tabs" on={i === 0} data-scene={s} class="flex-1 px-1.5 last:border-r-0">
            {s}
          </Tab>
        ))
      }
      <div
        id="demo-screen"
        aria-live="off"
        class:list={[SCREEN, 'h-[360px] max-h-none max-[600px]:h-[300px] max-[600px]:text-[11px]']}
        set:html={frameHtml(heroScenes.audit)}
      />
    </Terminal>
  </Wrap>
</header>

<script>
  import { copyText } from '../../scripts/copy';
  import { Player, reducedMotion } from '../../scripts/motion';
  import { heroScenes } from '../../scripts/scenes';

  const quick = document.getElementById('quick-cmd')!;
  const quickBtn = document.getElementById('quick-copy')!;
  quickBtn.addEventListener('click', () => copyText(quick.querySelector('[data-cmd]')!.textContent ?? '', quickBtn, quick));

  type Scene = keyof typeof heroScenes;
  const still = reducedMotion();
  const clock = document.getElementById('demo-clock')!;
  const title = document.getElementById('demo-title')!;
  const hero = new Player(document.getElementById('demo-screen')!, {
    title: (t) => (title.textContent = t),
    clock: (t, ok) => {
      clock.hidden = t == null;
      if (t == null) return;
      clock.textContent = t;
      clock.dataset.tone = ok ? 'g' : 'a';
    },
  });
  const order = Object.keys(heroScenes) as Scene[];
  const tabs = document.querySelectorAll<HTMLButtonElement>('#demo [role=tab]');
  const select = (name: Scene) => tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.scene === name)));

  function run(i: number) {
    const name = order[i % order.length];
    select(name);
    if (still) return hero.render(heroScenes[name]);
    hero.play(heroScenes[name], { keep: true }).then(
      () => run(i + 1),
      () => {},
    );
  }
  tabs.forEach((b) => b.addEventListener('click', () => run(order.indexOf(b.dataset.scene as Scene))));

  // Open on the audit's finished frame (rendered at build), hold it, then play on from plan.
  if (!still)
    hero.sleep(3200, hero.tok).then(
      () => run(1),
      () => {},
    );
</script>
