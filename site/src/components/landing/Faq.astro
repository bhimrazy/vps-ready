---
import Code from './ui/Code.astro';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import SectionHead from './ui/SectionHead.astro';

// Answers mark inline code with backticks. A third item links to the guide
// with the long answer.
const faqs: [string, string, [string, string]?][] = [
  [
    'Is it safe on a server that is already running things?',
    'It audits first and shows the full plan. Nothing changes until you approve it. Every change is journaled, and `sudo vps-ready rollback --last` restores the previous state. More in',
    ['Harden a server that is already running services', '/docs/guides/existing-server/'],
  ],
  [
    'Which systems does it support?',
    'Debian 12 and 13 and Ubuntu 22.04, 24.04 and 26.04, with systemd, on x86_64 and arm64. Both architectures are built, but only x86_64 runs in the VM tests (nightly, on all five releases). On other Linux distros, detect and audit still run. More distros are on the roadmap.',
  ],
  [
    'Will it fight with ufw, firewalld or Docker?',
    'The firewall module stays out of the way when ufw or firewalld is in use. The audit checks whether container ports bypass the firewall.',
  ],
  [
    'Do I need root?',
    'For changes, yes: `apply`, `confirm`, `rollback` and `history` need root, so run them with sudo on the server itself. `detect` and `plan` work without it, and so does `audit`, but some of its checks need root and show as unknown without it. There is no agent and no control machine.',
  ],
  [
    'What if I lose access after confirming?',
    "Run `sudo vps-ready rollback --last` from any working session, or from your provider's console. More in",
    ['Undo changes and recover from an SSH lockout', '/docs/guides/undo-and-recover/'],
  ],
];
---

<Section id="faq">
  <SectionHead label="FAQ" center>
    <Fragment slot="title">Questions before you run it.</Fragment>
    The short answers. The <a class="text-brand no-underline hover:underline" href="/docs/">docs</a> have the long ones.
  </SectionHead>
  <Panel class="mx-auto max-w-[760px]">
    {
      faqs.map(([q, a, more]) => (
        <details class="group border-t border-line first:border-t-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold hover:bg-surface [&::-webkit-details-marker]:hidden">
            {q}
            <svg
              class="size-4 flex-none text-muted transition-transform duration-200 group-open:rotate-180 group-open:text-ink group-hover:text-ink motion-reduce:transition-none"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4" />
            </svg>
          </summary>
          <p class="max-w-[70ch] px-5 pb-[18px] text-[15px] leading-[1.7] text-muted">
            {a.split('`').map((part, i) => (i % 2 ? <Code>{part}</Code> : part))}
            {more && (
              <>
                {' '}
                <a class="text-brand no-underline hover:underline" href={more[1]}>
                  {more[0]}
                </a>
                .
              </>
            )}
          </p>
        </details>
      ))
    }
  </Panel>
</Section>
