---
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import SectionHead from './ui/SectionHead.astro';

const code = (s: string) =>
  `<code class="rounded-md border border-line bg-surface px-1.5 py-px font-mono text-[13px] font-medium wrap-anywhere">${s}</code>`;
const faqs = [
  [
    'Is it safe on a server that is already running things?',
    `It audits first and shows the full plan. Nothing changes until you approve it. Every change is journaled, and ${code('sudo vps-ready rollback --last')} restores the previous state.`,
  ],
  [
    'Which systems does it support?',
    'Linux on x86_64 and arm64. It is tested nightly on Ubuntu 22.04 and 24.04 and Debian 12 and 13. More distros are on the roadmap.',
  ],
  [
    'Will it fight with ufw, firewalld or Docker?',
    'The firewall module stays out of the way when ufw or firewalld is in use. The audit checks whether container ports bypass the firewall.',
  ],
  ['Do I need root?', 'Yes. Run it with sudo on the server itself. There is no agent and no control machine.'],
  [
    'What if I lose access after confirming?',
    `Run ${code('sudo vps-ready rollback --last')} from any working session, or from your provider's console.`,
  ],
];
---

<Section id="faq">
  <SectionHead center>
    <Fragment slot="title">Questions before you run it.</Fragment>
    The short answers. The <a class="text-brand no-underline hover:underline" href="/docs/">docs</a> have the long ones.
  </SectionHead>
  <Panel class="mx-auto max-w-[760px]">
    {
      faqs.map(([q, a]) => (
        <details class="group border-t border-line first:border-t-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold hover:bg-surface [&::-webkit-details-marker]:hidden">
            {q}
            <svg
              class="size-4 flex-none text-muted transition-transform duration-200 group-open:rotate-180 group-open:text-ink group-hover:text-ink motion-reduce:transition-none"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4" />
            </svg>
          </summary>
          <p class="max-w-[70ch] px-5 pb-[18px] text-[15px] leading-[1.7] text-muted" set:html={a} />
        </details>
      ))
    }
  </Panel>
</Section>
