---
import { REPO } from '../../lib/site';
import InstallBlock from './InstallBlock.astro';
import Code from './ui/Code.astro';
import Section from './ui/Section.astro';
import SectionHead from './ui/SectionHead.astro';

const link = 'font-mono text-sm font-medium text-brand no-underline hover:underline';
---

<Section id="start" alt wrapClass="grid justify-items-center gap-[22px] text-center">
  <SectionHead label="Get started" center flush>
    <Fragment slot="title">Audit first. It changes nothing.</Fragment>
    Install it, run <Code>sudo vps-ready audit</Code>, and read the result. Then decide.
  </SectionHead>
  <InstallBlock class="max-w-[820px]" primaryCopy />
  <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
    <a class={link} href={REPO}>View on GitHub</a>
    <a class={link} href="/docs/">Read the docs</a>
  </div>
</Section>
