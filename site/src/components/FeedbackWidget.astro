---
// Floating feedback button and panel, on the landing page and the docs.
// Plain links to GitHub and email: the site sends nothing anywhere itself.
import { CONTACTS, EMAIL, MAIL_ICON, MAILTO } from '../lib/site';
import Icon from './landing/ui/Icon.astro';

const rows = [{ href: MAILTO, title: 'Email', note: EMAIL, icon: MAIL_ICON }, ...CONTACTS];
const row =
  'group/row grid grid-cols-[20px_minmax(0,1fr)] items-center gap-3 rounded-md px-2.5 py-1.5 text-ink no-underline hover:bg-surface focus-visible:bg-surface dark:text-(--sl-color-white) dark:hover:bg-(--sl-color-gray-5) dark:focus-visible:bg-(--sl-color-gray-5)';
const muted = 'text-muted dark:text-(--sl-color-gray-3)';
// Dark styles use Starlight's theme variables; the landing page is light only.
const accent =
  'bg-brand text-on-accent hover:bg-brand-ink dark:bg-(--sl-color-accent) dark:text-(--sl-color-text-invert) dark:hover:bg-(--sl-color-accent-high)';
---

<div data-feedback data-pagefind-ignore class="fixed right-4 bottom-4 z-50 font-sans sm:right-6 sm:bottom-6">
  <div
    id="feedback-panel"
    role="dialog"
    aria-labelledby="feedback-title"
    popover="manual"
    class="inset-auto right-4 bottom-4 m-0 w-[min(calc(100vw-2rem),20rem)] overflow-hidden rounded-[10px] border border-line p-0 sm:right-6 sm:bottom-6 bg-bg text-ink shadow-[0_24px_48px_-20px_rgb(31_35_40/0.35)] dark:border-(--sl-color-gray-5) dark:bg-(--sl-color-gray-6) dark:text-(--sl-color-white)"
  >
    <div class="flex items-start gap-3 border-b border-line bg-surface px-4 py-3 dark:border-(--sl-color-gray-5) dark:bg-(--sl-color-black)">
      <div class="min-w-0 flex-1">
        <p id="feedback-title" class="m-0 font-mono text-sm font-bold">Feedback</p>
        <p class:list={['m-0 text-xs', muted]}>Questions, ideas or problems with vps-ready.</p>
      </div>
      <button
        type="button"
        data-close
        aria-label="Close feedback"
        class="-mr-1 cursor-pointer rounded-md border-0 bg-transparent p-1 text-muted hover:bg-grid hover:text-ink dark:text-(--sl-color-gray-3) dark:hover:bg-(--sl-color-gray-5) dark:hover:text-(--sl-color-white)"
      >
        <svg class="block size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"
          ><path d="M4 4l8 8M12 4l-8 8"></path></svg
        >
      </button>
    </div>

    <ul class="m-0 grid list-none gap-0.5 p-2">
      {
        rows.map((r) => (
          <li class="m-0">
            <a href={r.href} class={row}>
              <Icon d={r.icon} small class:list={['stroke-[1.8]', muted]} />
              <span class="grid min-w-0">
                <b class="text-sm font-semibold group-hover/row:text-brand dark:group-hover/row:text-(--sl-color-text-accent)">{r.title}</b>
                <em class:list={['font-mono text-xs not-italic wrap-anywhere', muted]}>{r.note}</em>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <button
    type="button"
    data-toggle
    aria-expanded="false"
    aria-controls="feedback-panel"
    class:list={[
      'ml-auto flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-2 rounded-full border-0 px-4 font-mono text-[13px] font-medium shadow-[0_8px_24px_-8px_rgb(26_127_55/0.6)] aria-expanded:hidden max-[640px]:px-0',
      accent,
    ]}
  >
    <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"
      ><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"></path></svg
    >
    <span class="max-[640px]:sr-only">Feedback</span>
  </button>
</div>
{/* On phones, extra space at the end of the page so the last lines can scroll clear of the button. */}
<div data-feedback-spacer aria-hidden="true" class="h-16 sm:hidden"></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-feedback]')!;
  // Mount at the end of <body>: inside the docs content the button would sit
  // under Starlight's right sidebar and could not be clicked.
  document.body.append(document.querySelector('[data-feedback-spacer]')!, root);
  const panel = root.querySelector<HTMLElement>('#feedback-panel')!;
  const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;

  function setOpen(open: boolean) {
    panel.togglePopover(open);
    toggle.setAttribute('aria-expanded', String(open));
    (open ? panel.querySelector('a')! : toggle).focus();
  }
  toggle.addEventListener('click', () => setOpen(true));
  root.querySelector('[data-close]')!.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.matches(':popover-open')) setOpen(false);
  });
</script>
